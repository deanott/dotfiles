# I3 config file (v4)
# Please see http://i3wm.org/docs/userguide.html for a complete reference!

# Nerd Font required: i3status uses Nerd Font glyphs for its icons
font pango:JetBrainsMono Nerd Font:bold 11

# core mod key 
set $mod Mod4

# Workspaces

set $ws1 "1:  "
set $ws2 "2:  "
set $ws3 "3:  "

# # switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# switch to workspace
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# change focus
bindsym $mod+h focus left; mode "default"
bindsym $mod+j focus down; mode "default"
bindsym $mod+k focus up; mode "default"
bindsym $mod+l focus right; mode "default"

# move focused window
bindsym $mod+Shift+b move left
bindsym $mod+Shift+n move down
bindsym $mod+Shift+p move up
bindsym $mod+Shift+f move right

# kill focused window
bindsym $mod+e kill

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen


# Show the first scratchpad window
bindsym $mod+minus [con_mark="scratch0"] scratchpad show
bindsym $mod+plus [con_mark="scratch1"] scratchpad show

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle; mode "default"

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle; mode "default"

# start a terminal shel
bindsym $mod+Return exec kitty

# start dmenu (a program launcher)
bindsym $mod+r exec --no-startup-id rofi -show drun

# move output
bindsym $mod+comma move workspace to output left
bindsym $mod+period move workspace to output right

# split in horizontal orientation
bindsym $mod+Shift+h split h

# split in vertical orientation
bindsym $mod+Shift+v split v

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacked
bindsym $mod+Shift+s layout toggle split

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
bindsym $mod+d focus child

# Inspect memory
bindsym $mod+i exec i3-sensible-terminal htop #bindsym $mod+i exec i3-sensible-terminal top


# reload the configuration file
Bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart

bindsym Print exec --no-startup-id ~/.config/i3/scripts/screenshot
bindsym $mod+Print exec --no-startup-id ~/.config/i3/scripts/screenshot full

# Clipboard hist
bindsym $mod+v exec --no-startup-id CM_LAUNCHER=rofi clipmenu

#For no x-keys
bindsym Shift+Home exec "xbacklight -inc 10"
bindsym Shift+End exec "xbacklight -dec 10"

# X Keys
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl -- set-sink-volume @DEFAULT_SINK@ +5% #increase sound volume
bindsym XF86AudioLowerVolume exec --no-startup-id pactl -- set-sink-volume @DEFAULT_SINK@ -5% #decrease sound volume
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle # mute sound

bindsym XF86MonBrightnessUp exec --no-startup-id xbacklight -inc 5
bindsym XF86MonBrightnessDown exec --no-startup-id xbacklight -dec 5

# Resizing
bindsym $mod+Ctrl+l resize shrink width 1 px or 1 ppt
bindsym $mod+Ctrl+j resize grow height 1 px or 1 ppt
bindsym $mod+Ctrl+k resize shrink height 1 px or 1 ppt
bindsym $mod+Ctrl+h resize grow width 1 px or 1 ppt

set $leftOrient "xrandr -o left" 
set $rightOrient "xrandr -o right" 
set $normalOrient "xrandr -o normal"

# Colors
set_from_resource $blue blue #A0E7E5 
set_from_resource $yellow yellow  #FBE7C6
set_from_resource $grey grey  #353D49
set_from_resource $green green  $#69A59E
set_from_resource $red red #$blue

set_from_resource $background background #5188A5
set_from_resource $foreground foreground #BF7B71

# Bar block colors. Literals, not set_from_resource: Xresources *blue is
# #518F9C, too close to the bar background to read as a separate block.
# The pair is matched in HSL (~37%/33% sat, ~59%/56% light) so neither one
# jumps out; brighter pastels read as washed out against the bar.
# Kept in sync with the span backgrounds in ~/.config/i3status/config.
set $pink        #BF7B71
set $pastel_blue #6AB4B1

# My colors
client.focused		      	$yellow 	$blue		$yellow		$yellow		$yellow
client.focused_inactive		$yellow		$blue		$grey		$yellow		$foreground	
client.unfocused	      	$yellow		$blue		$grey		$yellow		$foreground
client.urgent		        $yellow		$blue		$yellow		$yellow		$red
client.placeholder	    	$yellow		$blue		$yellow		$yellow 	$yellow


set $transparent #00000000

# Start i3bar to display a workspace bar (plus the system information i3status finds out, if available)
bar {
  #i3 status no i3bar
  colors {
    background $background
    statusline $grey
    separator  $background

    #                       border            background      text
    focused_workspace       $pastel_blue      $pastel_blue    $grey
    active_workspace        $pink             $pink           $grey
    inactive_workspace      $pink             $pink           $grey
    urgent_workspace        $red              $red            $yellow
    binding_mode            $yellow           $yellow         $grey
  }

  # NOTE: no --transparency: it gives XEmbed tray icons (nm-applet) a black
  # backdrop. $background is opaque, so transparency bought nothing anyway.
  i3bar_command i3bar
  status_command i3status

  position top
  strip_workspace_numbers yes
  workspace_buttons yes

  # match the visual weight of the i3status blocks on the right
  workspace_min_width 34

  tray_padding 6

  font pango:JetBrainsMono Nerd Font:bold 10

  #height in pixels
  height 30
}

# GAPS CONFIGURATION
for_window [class=".*"] border pixel 2

# change borders
bindsym $mod+b border normal 
bindsym $mod+n border none 

default_border pixel 1 

set $gaps_inner_default 6 
set $gaps_outer_default 6 

gaps inner $gaps_inner_default
gaps outer $gaps_outer_default

#smart_gaps on

#smart_borders on


# Lock Screen
set $Locker i3lock -c 807c7c && sleep 1

# Create Log out, Reboot, Poweroff bindings
set $lockModeName "Exit (L)ockdown, (R)eboot, (P)oweroff, (E)xit"
mode $lockModeName {
    bindsym $mod+r exec sudo reboot
    bindsym $mod+l exec --no-startup-id $Locker, mode "default"
    bindsym $mod+e exec i3-msg exit
    bindsym $mod+p exec poweroff 

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Shift+e mode $lockModeName

# window specific setting
for_window [class="Steam"] floating enable
for_window [class="Wine"] floating enable

#Godot_Editor
for_window [class="Godot_Engine"] floating enable
for_window [class="Godot_Editor"] floating enable
for_window [class="Godot"] floating enable
for_window [class="glorpcat"] floating enable
for_window [title="Alert!"] floating enable, focus

# Flameshot's selection overlay is a NORMAL window, so i3 tiles it and the
# crosshair ends up confined to a tile. Float it and pin it to 0,0 so it
# covers the full X screen across all outputs.
for_window [class="flameshot"] floating enable, border pixel 0, fullscreen disable, move absolute position 0 0


for_window [instance="chromium"] border 1
for_window [class="google-chrome"] border none
for_window [instance="google-chrome"] border none
for_window [instance="dropdown"] mark "term", move scratchpad, resize set 1920 810, move absolute position 0 0


# Startup commands
exec xsetroot -solid $background

# Wallpaper. NOT a bare `exec feh`: feh sizes the root pixmap to the screen as
# it is when it runs, and X tiles that pixmap when a second monitor grows the
# root window. This watcher re-runs feh on every RandR change instead.
exec_always --no-startup-id ~/.config/i3/scripts/display/watch-outputs.sh

# Caps->Ctrl, plus the .Xmodmap that puts the external keyboard's Super
# (keycode 206) into mod4. NOT bare `exec setxkbmap` / `exec xmodmap`: X resets
# the keymap every time a keyboard is hotplugged, which silently undoes both.
# This watcher re-applies them on each device add/remove.
#
# Caps->Ctrl is ALSO baked into the X server default via
# /etc/X11/xorg.conf.d/00-keyboard.conf (XkbOptions "ctrl:nocaps"), so it holds
# from the very first frame at login regardless of device-enumeration timing --
# this watcher's setxkbmap call is now redundant for Caps and only the .Xmodmap
# (keycode 206) genuinely still needs re-applying on hotplug.
exec_always --no-startup-id ~/.config/i3/scripts/input/watch-keyboard.sh

# Startup applications
# Bridge SNI/appindicator tray items (copycat-ui, most modern GTK/Qt/Electron
# apps) into i3bar's XEmbed-only systray. Without this, only XEmbed icons show.
# Started first so it owns the StatusNotifierWatcher before tray apps register.
exec --no-startup-id snixembed --fork

# Wifi applet. Wrapped, not bare: the wrapper renames it so i3bar's
# class-sorted tray always puts it at the far right. See the script.
exec --no-startup-id ~/.config/i3/scripts/tray/wifi-applet.sh

# Clipboard history UI. copycatd itself is a systemd user unit
# (~/.config/systemd/user/copycatd.service, enabled); this is just the tray
# front-end, started hidden. ~/.config/autostart/copycat-ui.desktop does NOT
# cover it -- XDG autostart entries need xdg-desktop-autostart.target, which
# only a full desktop session starts and which is inactive under i3.
exec --no-startup-id ~/.config/i3/scripts/startup/copycat.sh

# Flameshot daemon. Without it running, the first `flameshot gui` has to spawn
# it and races the capture, which is why it took two invocations to work.
exec --no-startup-id flameshot

exec --no-startup-id dunst -config ~/.config/dunst/dunstrc
exec --no-startup-id i3-battery-popup -n -D -L 20 -l 10 

exec_always --no-startup-id xfce4-power-manager
exec_always --no-startup-id $HOME/.config/polybar/launch.sh
exec_always --no-startup-id xrdb -load ~/.Xresources
exec_always --no-startup-id xrdb ~/.Xresources

for_window [class="com.defold.editor.Start"] floating enable

