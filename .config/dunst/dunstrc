[global]
title = Dunst
class = Dunst
monitor = 0
follow = mouse
# geometry/shrink were removed in dunst 1.7 and had been silently ignored ever
# since, so placement has really been dunst's default all along. Only width is
# pinned here; placement stays default and keeps honouring follow = mouse.
width = 280
indicate_hidden = yes

transparency = 0
separator_height = 1
padding = 4
horizontal_padding = 8
frame_width = 2
frame_color = "#3b4252"
separator_color = "#404859"

font = mplus nerd font 9

line_height = 0
markup = full
format = "<span font_desc='Cantarell 9' weight='bold' foreground='#f9f9f9'>%s</span>\n%b"
alignment = center

idle_threshold = 120
show_age_threshold = 60
sort = no
word_wrap = yes
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = no
show_indicators = no
sticky_history = no
history_length = 20
always_run_script = true
corner_radius = 0
icon_position = left
max_icon_size = 32

# Theme lookup instead of hardcoded 48x48 dirs: survives Papirus reorganising its
# tree, and falls back through hicolor. The old icon_path pointed at
# Papirus-Dark-Custom, an unpackaged theme that got wiped, which silently killed
# every icon.
icon_theme = Papirus-Dark
enable_recursive_icon_lookup = true

# Kept inside dotfiles on purpose — the previous cat lived only in /usr/share/icons,
# owned by no package and tracked by nothing, so it was unrecoverable once removed.
# Reached via ~/.config/dunst (the symlink install.sh makes) rather than the repo
# path, so it resolves wherever the repo is cloned. dunst runs default_icon
# through wordexp(3), so the leading ~ expands.
default_icon = ~/.config/dunst/icons/glorpcat.png

browser = chromium

mouse_left_click = close_current
mouse_middle_click = do_action
mouse_right_click = close_all

[shortcuts]
close = ctrl+space
close_all = ctrl+shift+space
history = ctrl+Escape
context = ctrl+shift+period

[urgency_low]
timeout = 3
background = "#3b4252"
foreground = "#f9f9f9"

[urgency_normal]
timeout = 6
background = "#3b4252"
foreground = "#f9f9f9"

[urgency_critical]
timeout = 0
background = "#3b4252"
foreground = "#f9f9f9"