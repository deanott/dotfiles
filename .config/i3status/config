# i3status configuration file. see "man i3status" for documentation.
# Icons are Nerd Fonts v2 glyphs -- the bar font MUST be a Nerd Font
# (set in ~/.config/i3/config) or these render as boxes.

general {
	output_format = "i3bar"
	interval = 5
	colors = true
	color_good = '#353D49'
	color_degraded = '#7A4A22'
	color_bad = '#9d2c2e'
	markup = "pango"
	separator = " <span foreground='#353D49'></span> "
}

order += "volume master"
order += "memory"
order += "disk /"
order += "path_exists VPN"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery 0"
order += "tztime local"

volume master {
	format = "<span background='#BF7B71'>  %volume </span>"
	format_muted = "<span background='#BF7B71'>  muted </span>"
	device = "default"
	mixer = "Master"
	mixer_idx = 0
}

memory {
	format = "<span background='#6AB4B1'>  %used </span>"
	format_degraded = "<span background='#6AB4B1'>  %used </span>"
	memory_used_method = "memavailable"
	threshold_degraded = "12%"
	threshold_critical = "6%"
	unit = "G"
	decimals = 1
}

disk "/" {
	format = "<span background='#BF7B71'>  %free </span>"
	low_threshold = 10
	threshold_type = "percentage_free"
}

path_exists VPN {
	format = "<span background='#D4B483'>  %title </span>"
	format_down = ""
	path = "/sys/class/net/tun0"
}

wireless _first_ {
	format_up = "<span background='#6AB4B1'>  %essid %bitrate </span>"
	format_down = "<span background='#6AB4B1'>  down </span>"
	format_bitrate = "%.2f%cb/s"
}

ethernet _first_ {
	format_up = "<span background='#6AB4B1'>  %speed </span>"
	format_down = ""
}

battery 0 {
	format = "<span background='#BF7B71'> %status %percentage </span>"
	format_down = ""
	status_chr = ""
	status_bat = ""
	status_unk = ""
	status_full = ""
	path = "/sys/class/power_supply/BAT%d/uevent"
	last_full_capacity = true
	integer_battery_capacity = true
	low_threshold = 20
}

tztime local {
	# \u200e = LTR mark: the cat glyph (U+FBA3) lives in the Arabic block and
	# will bidi-flip the date without these.
	format = "<span background='#6AB4B1'> ‎ﮣ‎  %Y-%m-%d %H:%M </span>"
}
